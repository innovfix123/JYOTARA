[Unit]
Description=Jyotara private analytics dashboard
After=network-online.target postgresql.service
[Service]
Type=simple
User=jyotara-dashboard
Group=jyotara-dashboard
WorkingDirectory=/opt/jyotara/dashboard
EnvironmentFile=/etc/jyotara/dashboard.env
ExecStart=/opt/jyotara-node/bin/node /opt/jyotara/dashboard/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jyotara-dashboard
UMask=0077
MemoryMax=256M
CPUQuota=50%
[Install]
WantedBy=multi-user.target
